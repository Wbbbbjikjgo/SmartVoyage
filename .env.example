# LLM Configuration (DeepSeek)
OPENAI_API_KEY=your_deepseek_api_key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# AMap Open Platform (高德开放平台) - weather / hotel / geocode
# 申请地址: https://lbs.amap.com/
AMAP_API_KEY=your_amap_web_service_key
WEATHER_MOCK_MODE=false
HOTEL_MOCK_MODE=false

# Aliyun API Market (阿里云 API 市场) - flight / train
# 申请地址: https://market.aliyun.com/
ALIYUN_APPCODE=your_aliyun_appcode
# 注意：航班/火车票为付费接口，免费额度极少，默认开启 mock 保护额度
# 确认配额充足后再改为 false
FLIGHT_MOCK_MODE=true
TRAIN_MOCK_MODE=true

# MySQL Configuration (Local)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smartvoyage

# Redis Configuration (Local)
REDIS_URL=redis://localhost:6379/0

# Elasticsearch Configuration (Docker)
ES_URL=http://localhost:9200

# Agent Ports
WEATHER_AGENT_PORT=5001
FLIGHT_AGENT_PORT=5002
HOTEL_AGENT_PORT=5003
ITINERARY_AGENT_PORT=5004
TRAIN_AGENT_PORT=5005

# MCP Server Ports
WEATHER_MCP_PORT=5010
FLIGHT_MCP_PORT=5011
HOTEL_MCP_PORT=5012
DB_MCP_PORT=5013
TRAIN_MCP_PORT=5014

# API Gateway
API_GATEWAY_PORT=8000

# Streamlit
STREAMLIT_PORT=8501
